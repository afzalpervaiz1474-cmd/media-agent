# =============================================================================
# Modulate — environment variables
# Copy this file to `.env`, fill in real values, and NEVER commit `.env`.
# Anything with the `VITE_` prefix ships to the browser; everything else is
# server-only (used by Vercel serverless functions in api/).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Server URL used for OAuth redirect URI construction and API defaults
APP_HOST=

# Same values, exposed to the Vite frontend
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# -----------------------------------------------------------------------------
# Google Sign-In (optional; enables the "Continue with Google" button)
# -----------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# -----------------------------------------------------------------------------
# AI Provider Manager
# -----------------------------------------------------------------------------
# The app uses a centralized AI Provider Manager. Every agent (orchestrator,
# YouTube/TikTok/Instagram/Facebook, chat, metadata) resolves its model through
# this manager. Resolution order per user:
#   1. The user's primary provider (configured on /settings/ai-providers).
#   2. Any of the user's providers marked "allow_fallback".
#   3. Server env defaults defined below (system admin default).
# Individual users can also bring their own API keys — stored encrypted at rest.
#
# Server env defaults (system admin default). At least ONE of these is
# recommended so the app works out-of-the-box for new users:

# Primary recommended: OpenRouter (single key, many models). Model + base URL
# are configurable at runtime from settings without redeploying.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=Ling 3.0 Flash VL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Requests per user, per hour, allowed against the shared PLATFORM key.
# Users who bring their own key on /settings/ai-providers bypass this limit.
# Set to 0 to disable rate limiting.
PLATFORM_AI_HOURLY_LIMIT=60

# Optional alternatives (any of these work as server default):
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: OmniRoute self-hosted gateway (free, MIT). You run the gateway
# yourself — see the README "OmniRoute" section. The app talks to it over its
# OpenAI-compatible /v1 API, and model "auto" lets the gateway pick a
# provider/model itself. OMNIROUTE_API_KEY is the token from YOUR gateway
# dashboard — never copy a key from any repo. OpenRouter stays the default
# provider; OmniRoute is used only when configured here (or per-user on
# /settings/ai-providers).
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Public origin used as `HTTP-Referer` on OpenRouter requests
PUBLIC_APP_URL=
AI_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# YouTube (Google OAuth 2.0 client with YouTube Data API v3 enabled)
# https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional. If omitted, defaults to https://<your-host>/api/oauth/youtube/callback.
# Whatever value ends up in effect MUST be listed as an authorized redirect URI
# in the Google Cloud OAuth client.
YOUTUBE_REDIRECT_URI=
# Set to false when your Google Cloud OAuth app is published to "In Production" and users can connect without Google verification.
# Set to true while the app is in testing mode or waiting for Google verification.
OAUTH_TESTING_MODE=true

# -----------------------------------------------------------------------------
# TikTok (Login Kit + Content Posting API)
# https://developers.tiktok.com/
# NOTE: apps must pass TikTok review before publishing on behalf of non-test users.
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Meta (shared between Instagram and Facebook publishing)
# https://developers.facebook.com/apps
# NOTE: instagram_content_publish + pages_manage_posts must pass App Review
# before you can publish on behalf of arbitrary users.
# Instagram publishing requires an Instagram Business/Creator account linked
# to a Facebook Page the connecting user administers.
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Vercel / Supabase database resilience (leave as-is if using Design Arena)
# -----------------------------------------------------------------------------
FULLSTACK_PROJECT_REF=
FULLSTACK_RESTORE_API_URL=

# -----------------------------------------------------------------------------
# Video analysis (v1) — all optional, all overridable.
# Without these, video jobs complete with "skipped" steps (never fabricated).
# -----------------------------------------------------------------------------
# Max video length the pipeline accepts (minutes). Longer videos are
# rejected with a clear error at enqueue time and in the job.
MAX_VIDEO_MINUTES=10
# FFmpeg binaries (defaults: ffmpeg / ffprobe from PATH).
FFMPEG_PATH=
FFPROBE_PATH=
# Frame extraction: one frame every N seconds, at most M frames.
VIDEO_FRAME_INTERVAL_SEC=12
VIDEO_MAX_FRAMES=16
# Speech-to-text: Whisper-compatible endpoint (OpenAI-compatible
# /audio/transcriptions). Falls back to OPENAI_API_KEY / OPENAI_BASE_URL.
VIDEO_STT_API_KEY=
VIDEO_STT_BASE_URL=
VIDEO_STT_MODEL=whisper-1
# Vision: env-only in v1 (the model MUST support image input).
# Falls back to OPENROUTER_API_KEY / OPENROUTER_BASE_URL for the key.
VIDEO_VISION_API_KEY=
VIDEO_VISION_BASE_URL=
VIDEO_VISION_MODEL=
# Thumbnail images: OpenAI-compatible /images/generations endpoint.
# Falls back to OPENAI_API_KEY / OPENAI_BASE_URL.
VIDEO_IMAGE_API_KEY=
VIDEO_IMAGE_BASE_URL=
VIDEO_IMAGE_MODEL=
VIDEO_IMAGE_SIZE=1024x1024
VIDEO_THUMBNAIL_COUNT=3
# Polling worker (scripts/video-worker.mjs).
WORKER_POLL_MS=5000
WORKER_BATCH=5
# Prompt-size guards (chars).
VIDEO_TRANSCRIPT_EXCERPT_CHARS=4000
VIDEO_FRAME_NOTES_EXCERPT_CHARS=2000
